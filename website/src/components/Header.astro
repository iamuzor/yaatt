---
import { path } from "../lib/paths";

const current = Astro.url.pathname;
const docsActive = current.includes("/docs");
---

<header class="site-header">
  <nav class:list={[Astro.props.wide ? "docs-wrap" : "wrap"]}>
    <a class="brand" href={path("/")}>
      <svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#111412"></rect>
        <rect x="1" y="1" width="30" height="30" rx="5" stroke="#3dcc7a" stroke-width="1.5"></rect>
        <path d="M8 17.2 13.2 22.4 24 10.4" stroke="#3dcc7a" stroke-width="2.4" stroke-linecap="square"></path>
      </svg>
      YAATT
    </a>
    <div class="nav-links">
      <a href={path("/docs/")} aria-current={docsActive ? "page" : undefined}>Docs</a>
      <a href={path("/#contact")}>Contact</a>
      <a href="https://github.com/iamuzor/yaatt">GitHub</a>
    </div>
  </nav>
</header>
