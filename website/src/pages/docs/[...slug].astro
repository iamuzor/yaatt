---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import { path } from "../../lib/paths";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  const ordered = docs.sort((a, b) => a.data.order - b.data.order);

  return ordered.map((doc, index) => ({
    params: { slug: doc.id },
    props: {
      doc,
      prev: ordered[index - 1] ?? null,
      next: ordered[index + 1] ?? null,
    },
  }));
}

interface Props {
  doc: CollectionEntry<"docs">;
  prev: CollectionEntry<"docs"> | null;
  next: CollectionEntry<"docs"> | null;
}

const { doc, prev, next } = Astro.props;
const { Content } = await render(doc);
---

<Base title={doc.data.title} description={doc.data.description} wide>
  <div class="docs-wrap docs-shell">
    <DocsSidebar />
    <article class="docs-content">
      <h1>{doc.data.title}</h1>
      <p class="docs-lead">{doc.data.description}</p>
      <div class="prose">
        <Content />
      </div>
      <nav class="docs-pager">
        {
          prev ? (
            <a href={path(`/docs/${prev.id}/`)}>← {prev.data.title}</a>
          ) : (
            <span></span>
          )
        }
        {
          next ? (
            <a href={path(`/docs/${next.id}/`)}>{next.data.title} →</a>
          ) : (
            <span></span>
          )
        }
      </nav>
    </article>
  </div>
</Base>
